{
  "name": "architecture-of-light",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "native:sync": "npm run build && npx cap sync",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "ios:open": "npx cap open ios",
    "launch:check": "node scripts/launch-check.mjs",
    "e2e": "npm run build && playwright test",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "archive:probe": "node scripts/archive-probe.mjs",
    "archive:seed-sql": "node scripts/archive-seed-sql.mjs",
    "archive:bundle-sql": "node scripts/archive-bundle-sql.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@phosphor-icons/core": "2.1.1",
    "@supabase/supabase-js": "2.99.2",
    "leaflet": "1.9.4",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.3.7",
    "@playwright/test": "^1.56.1",
    "esbuild": "0.25.12",
    "oxigraph": "0.5.11",
    "sparqljs": "3.7.4"
  }
}
