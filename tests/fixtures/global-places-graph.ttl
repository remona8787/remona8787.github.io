wd:Q99300012 wdt:P31 wd:Q262166 ; rdfs:label "Lichtstadt"@en, "Lichtstadt"@de .

# A subclass of light installation, to exercise wdt:P31/wdt:P279*
wd:Q99300950 wdt:P279 wd:Q1823448 .

