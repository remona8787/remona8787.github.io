# A tiny Wikidata-shaped graph for running the real branch queries (buildBranchQuery) in a SPARQL engine
# (tests/global-places-sparql.test.mjs, oxigraph). Classes, countries, cities and query seeds use their real QIDs;
# districts, dongs and most places are fictional (Q993…/Q994…). Only the triples the queries read are modelled.
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix wikibase: <http://wikiba.se/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix p: <http://www.wikidata.org/prop/> .
@prefix psv: <http://www.wikidata.org/prop/statement/value/> .
@prefix wds: <http://www.wikidata.org/entity/statement/> .
@prefix wdv: <http://www.wikidata.org/value/> .

# Countries
wd:Q884 rdfs:label "대한민국"@ko, "South Korea"@en .
wd:Q17 rdfs:label "일본"@ko, "Japan"@en .
wd:Q142 rdfs:label "프랑스"@ko, "France"@en .
wd:Q183 rdfs:label "독일"@ko, "Germany"@en .
# ISO 3166-1 alpha-2 codes (P297)
wd:Q884 wdt:P297 "KR" . wd:Q17 wdt:P297 "JP" . wd:Q142 wdt:P297 "FR" . wd:Q183 wdt:P297 "DE" .

# City-level units (P31 in CITY_CLASSES) and the units around them
# Seoul also carries a generic class, and its 중구 the generic "big city" (as an editor might add by population): the
# Korean class of Seoul must still win, so places in 중구 are in 서울, not in a city called 중구.
wd:Q8684 wdt:P31 wd:Q7574799, wd:Q200250 ; wdt:P17 wd:Q884 ; rdfs:label "서울특별시"@ko, "Seoul"@en .
wd:Q99300001 wdt:P31 wd:Q99300900, wd:Q1549591 ; wdt:P131 wd:Q8684 ; rdfs:label "중구"@ko, "Jung District"@en .
